  "private": true,
  "scripts": {
    "simulator": "node simulador.js",
    "proyector": "node services/proyector.js",
    "notificaciones": "node services/notificaciones.js",
    "reprogramacion": "node services/reprogramacion.js",
    "monitor": "node services/monitor-sla.js",
